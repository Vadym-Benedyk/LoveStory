# Copy to deploy/.env and fill in (that file is git-ignored). docker-compose.yml reads it twice: for the
# compose settings below and as the API's environment. ../server/.env.example explains every app variable.
# A value containing a dollar sign must be wrapped in single quotes ('pa$$word'), otherwise compose
# takes it for a variable.

# --- Compose ---
# The API is served at https://api.<DOMAIN>.
DOMAIN=example.com
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=you@example.com
# Where the SQLite file lives (default: ./data next to this file).
# DATA_DIR=/opt/lovestory/data
# A prebuilt image instead of building on the server (then `docker compose pull`).
# API_IMAGE=ghcr.io/<owner>/lovestory-api:1.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# --- API ---
# The FIRST origin is the canonical one (used for links in notifications).
CLIENT_ORIGIN=https://example.com,https://www.example.com
# Caddy is the only proxy in front of the API.
TRUST_PROXY=1
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Only used by prisma:seed and admin:reset. Delete OWNER_PASSWORD from this file after the first run.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Photos (S3 behind CloudFront; the IAM user may only touch this bucket) ---
STORAGE_DRIVER=s3
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.example.com

# --- Notifications (optional) ---
# SMTP_URL=
# NOTIFY_EMAIL=
# NOTIFY_FROM=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
