# Copy to deploy/.env and fill in (that file is git-ignored). docker-compose.yml reads it twice: for the
# compose settings below and as the API's environment. ../server/.env.example explains every app variable.
# A value containing a dollar sign must be wrapped in single quotes ('pa$$word'), otherwise compose
# takes it for a variable.

# --- Compose ---
# The site is served at https://<DOMAIN> (www.<DOMAIN> redirects there), the API at /api on it and at
# https://api.<DOMAIN>.
DOMAIN=example.com
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=you@example.com
# Where the SQLite file and the photos (in uploads/) live (default: ./data next to this file).
# DATA_DIR=/opt/lovestory/data
# Where release.sh pulls the images GitHub Actions built (<this>-api/-tools/-web:<commit>). Unset: they are
# built on this server instead, which keeps a 1 GB machine busy for ~5 minutes per release.
IMAGE_REGISTRY=ghcr.io/<owner>/lovestory
# HTTP_PORT=80
# HTTPS_PORT=443

# --- API ---
# The FIRST origin is the canonical one (used for links in notifications).
CLIENT_ORIGIN=https://example.com,https://www.example.com
# Caddy is the only proxy in front of the API.
TRUST_PROXY=1
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Only used by prisma:seed and admin:reset. Delete OWNER_PASSWORD from this file after the first run.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Photos ---
# On this server's disk, in DATA_DIR/uploads, served by the API at https://<DOMAIN>/uploads (backed up by
# backup.sh with UPLOADS_S3_URI).
STORAGE_DRIVER=local
# Leave UPLOADS_PUBLIC_URL unset: photo links are then /uploads/..., on the site's own domain.
# Later, S3 behind CloudFront (infra/app.yml; the IAM user may only touch this bucket). Moving: copy
# DATA_DIR/uploads into the bucket as it is, then switch (server/src/lib/storage.ts).
# STORAGE_DRIVER=s3
# S3_REGION=eu-central-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com

# --- Notifications (optional) ---
# Email through Amazon SES (infra/mail.yml; the key is turned into the URL by infra/ses-smtp-url.py):
# SMTP_URL=smtps://<access key id>:<URL-encoded SMTP password>@email-smtp.eu-central-1.amazonaws.com:465
# Sender: any address @<your domain>. In the SES sandbox mail goes only to verified addresses.
# NOTIFY_FROM="LoveStory <info@example.com>"
# The owner's address for alerts (Settings in the admin overrides it):
# NOTIFY_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
