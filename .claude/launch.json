{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "port": 5173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "concurrently",
        "-n",
        "server,preview",
        "PORT=4000 npm run dev:server",
        "npm --workspace client run preview"
      ],
      "port": 4173
    }
  ]
}
