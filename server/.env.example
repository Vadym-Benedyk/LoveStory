# --- Server ---
NODE_ENV=development
PORT=4000
# comma-separated allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173
# Reverse proxies in front of the API (Railway/Render/Caddy/nginx: usually 1). Rate limits are
# per visitor IP; with 0 behind a proxy, ALL visitors share one limit. Keep 0 locally / when the
# API is reached directly (otherwise clients could spoof X-Forwarded-For).
TRUST_PROXY=0

# --- Database (SQLite: a single local file, no DB server) ---
# Path is relative to the prisma/ directory. In production point it at a persistent
# volume, e.g. DATABASE_URL=file:/data/lovestory.db
DATABASE_URL=file:./dev.db

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# seeded owner account (change after first login)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123!

# --- Booking rules ---
PENDING_EXPIRY_DAYS=7
DEFAULT_CURRENCY=UAH
TIMEZONE=UTC

# --- Photo storage (gallery / hero uploads from the admin) ---
# Uploads go through the API, which checks the file is really an image (JPEG/PNG/WebP/AVIF, max
# 15 MB) and then hands it to the storage driver. iPhone HEIC photos are converted to WebP in the
# admin's browser before they are sent, so the server only ever sees the formats above.
#
# local (default): files are saved on this server's disk and served at /uploads. Zero setup.
#   UPLOADS_DIR defaults to server/uploads. In production point it at a persistent volume,
#   e.g. UPLOADS_DIR=/data/uploads (same idea as DATABASE_URL above), and route /uploads to the
#   API in the reverse proxy next to /api. If the site and the API live on different origins,
#   set UPLOADS_PUBLIC_URL=https://api.example.com/uploads (affects photos uploaded afterwards).
STORAGE_DRIVER=local
# UPLOADS_DIR=
# UPLOADS_PUBLIC_URL=
#
# Each photo is stored together with a light thumbnail (<same name>-thumb.webp, made on upload; for photos
# uploaded before that, run `npm run media:thumbnails`), so always move/copy both.
#
# s3: AWS S3 or an S3-compatible service. To migrate: copy the contents of UPLOADS_DIR into the
# bucket unchanged (same keys: gallery/<category>/<file>), then set STORAGE_DRIVER=s3. Photos
# uploaded before the switch keep their stored local URL until you re-point them.
# The browser never talks to the bucket, so no bucket CORS rules are needed. The bucket (or the
# CloudFront domain in front of it) must serve the files publicly via S3_PUBLIC_URL.
#
# Production (real AWS S3) — leave S3_ENDPOINT unset, use a real region + IAM credentials
# (the IAM user needs s3:PutObject and s3:DeleteObject on the bucket):
# STORAGE_DRIVER=s3
# S3_REGION=eu-central-1
# S3_BUCKET=lovestory-media-prod
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://lovestory-media-prod.s3.eu-central-1.amazonaws.com   # or a CloudFront domain
#
# Local S3 for trying the s3 driver (MinIO — run `npm run storage:up`):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=lovestory-media
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000/lovestory-media

# --- Owner notifications about new booking requests (each channel optional) ---
# With nothing configured, requests are only logged + visible in the admin Requests inbox.
#
# Email: SMTP connection URL, e.g. smtps://user:pass@smtp.example.com:465
# (Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465 — needs an app password).
# Recipient = admin Settings → notification email, falling back to NOTIFY_EMAIL.
# NOTIFY_FROM defaults to the recipient; many SMTP providers require it to match the login.
SMTP_URL=
NOTIFY_EMAIL=owner@example.com
NOTIFY_FROM=
#
# Telegram: create a bot via @BotFather, send it any message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (message.chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
