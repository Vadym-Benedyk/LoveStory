# --- Server ---
NODE_ENV=development
PORT=4000
# comma-separated allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# --- Database (SQLite: a single local file, no DB server) ---
# Path is relative to the prisma/ directory. In production point it at a persistent
# volume, e.g. DATABASE_URL=file:/data/lovestory.db
DATABASE_URL=file:./dev.db

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# seeded owner account (change after first login)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123!

# --- Booking rules ---
PENDING_EXPIRY_DAYS=7
DEFAULT_CURRENCY=USD
TIMEZONE=UTC

# --- Object storage (gallery photo uploads) ---
# The admin Gallery page uploads directly from the browser to this bucket via a presigned PUT
# URL, so the bucket MUST allow PUT/GET (and OPTIONS preflight) from CLIENT_ORIGIN — configure
# CORS on the bucket, or uploads will fail with a browser CORS error even though the presign
# call itself succeeds. Leave these unset to run without gallery uploads (the admin Gallery
# page will show a "storage not configured" notice).
#
# Local dev (MinIO, S3-compatible — run `npm run storage:up`):
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lovestory-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/lovestory-media
#
# Production (real AWS S3) — leave S3_ENDPOINT unset, use a real region + IAM credentials:
# S3_REGION=eu-central-1
# S3_BUCKET=lovestory-media-prod
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://lovestory-media-prod.s3.eu-central-1.amazonaws.com   # or a CloudFront domain

# --- Notifications (optional in dev) ---
NOTIFY_EMAIL=owner@example.com
SMTP_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
